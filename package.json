{
  "name": "doug-interview-showcase",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "previews:capture": "node scripts/capture-previews.mjs",
    "hosting:deploy": "firebase deploy --only hosting",
    "hosting:serve": "npm run build && firebase emulators:start --only hosting --project demo-doug-portfolio"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "firebase-tools": "15.34.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
